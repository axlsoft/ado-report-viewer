{
  "name": "ado-html-report-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Private Azure DevOps tab for static HTML build reports.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run typecheck && vite build && npm run size",
    "dev": "vite --host 127.0.0.1",
    "fixtures": "node test/fixtures/generate.ts",
    "package": "npm run build && node --env-file-if-exists=.env scripts/extension.ts create",
    "publish": "npm run package && node --env-file-if-exists=.env scripts/extension.ts publish",
    "size": "node scripts/check-size.ts",
    "test": "vitest run",
    "test:e2e": "npm run fixtures && playwright test",
    "typecheck": "tsc --noEmit",
    "verify:vsix": "node scripts/verify-vsix.ts",
    "harness": "VITE_REPORT_HARNESS=1 vite build --outDir ../.harness-dist --emptyOutDir && vite preview --outDir ../.harness-dist --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "oxlint src test scripts"
  },
  "dependencies": {
    "azure-devops-extension-sdk": "5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "allure": "3.22.1",
    "allure-playwright": "3.14.0",
    "nyc": "18.0.0",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "reporting-labs": "0.6.22",
    "tfx-cli": "0.24.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
