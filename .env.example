# Copy to .env (gitignored) for local packaging and publishing. In CI, set the same names as
# pipeline variables, with AZURE_DEVOPS_EXT_PAT as a secret.

# Marketplace publisher ID that owns the extension.
EXTENSION_PUBLISHER=

# Azure DevOps organization(s) the private extension is shared with, separated by spaces or commas.
EXTENSION_SHARE_WITH=

# Personal access token with the Marketplace (publish) scope.
AZURE_DEVOPS_EXT_PAT=
